# Nessus: use API keys (Settings > My Account > API Keys) or a username and password.
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
NESSUS_USERNAME=
NESSUS_PASSWORD=

# Optional. Raises the NVD rate limit from 5 to 50 requests per 30 seconds.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Alerts (only needed for the channels you turn on in config.toml).
SLACK_WEBHOOK_URL=
SMTP_USERNAME=
SMTP_PASSWORD=

# Ticket systems (only needed for `vmt tickets --push ...`).
# Jira Cloud API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
SN_USERNAME=
SN_PASSWORD=

# LLM features (vmt extract --llm, vmt triage, vmt ask): the API key for the provider set under [llm] in config.toml.
LLM_API_KEY=

# Optional: raises GitHub search from 10 to 30 requests a minute for `vmt monitor`.
# A fine-grained token with no permissions is enough: https://github.com/settings/tokens
GITHUB_TOKEN=
